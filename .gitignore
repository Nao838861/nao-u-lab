# Repo root sits at D:/AI/Nao_u_BOT/ to allow Claude/ and GPT/ to coexist.
# Inner project gitignores (Claude/.gitignore, future GPT/.gitignore) handle
# their own contents. This root file only blocks accidents at the parent layer.

# Claude Code local settings auto-created when CLI runs from parent dir
.claude/

# Local UI/workbench state
.obsidian/
*.canvas

# Codex phase transient command captures
GPT/log/codex_phase_*_last.stdout.txt
GPT/log/codex_phase_*_last.stderr.txt
