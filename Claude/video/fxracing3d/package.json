{
  "type": "module",
  "name": "fxracing3d-explainer",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "rebuild": "node tools/rebuild_all.mjs",
    "studio": "remotion studio src/index.ts",
    "stills": "node tools/stills.mjs",
    "render": "remotion render src/index.ts FxExplainer out/fxracing3d_explainer.mp4 --codec=h264 --crf=18 --concurrency=2",
    "postrender": "node -e \"require('fs').copyFileSync('src/timing.json', 'out/fxracing3d_explainer.timing.json')\"",
    "splice": "node tools/splice.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.512",
    "@remotion/cli": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "5.9.3"
  }
}
