@@ -177,6 +177,9 @@ EMSCRIPTEN_KEEPALIVE unsigned web_peek(unsigned addr) {
     if(loaded&&addr>=0x6000&&addr<=0x7fff)if(auto fx=dynamic_cast<NesFxRacingPc*>(_console->GetMapper()))return fx->RecordRam()[addr-0x6000];
     return loaded ? _console->GetMemoryManager()->DebugRead(addr & 65535, true) : 0;
 }
+EMSCRIPTEN_KEEPALIVE void web_explainer_hide(unsigned v){explainer::hideFx=v?1:0;}
+EMSCRIPTEN_KEEPALIVE void *web_explainer_info(){return explainer::info;}
+EMSCRIPTEN_KEEPALIVE void *web_explainer_rows(){return explainer::rows;}
 EMSCRIPTEN_KEEPALIVE void web_poke(unsigned addr, unsigned value) {
     if(loaded&&addr>=0x6000&&addr<=0x7fff)if(auto fx=dynamic_cast<NesFxRacingPc*>(_console->GetMapper())){fx->RecordRam()[addr-0x6000]=value&255;return;}
     if (loaded) _console->GetMemoryManager()->DebugWrite(addr & 65535, value & 255, true);
