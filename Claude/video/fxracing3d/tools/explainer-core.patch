 // PC functional adapter for the published 2026-11-01 ROM/RTL pair.
 // CPU/GSU instructions execute normally. PSRAM copy/arbitration and the
 // watchdog are functional approximations; this is not FPGA timing evidence.
+namespace explainer {
+inline uint8_t hideFx=0;            // 1: 車・木・家（FX）を消して地面だけ
+inline uint8_t info[240][34][4]{};  // [y][タイル列] = {FXの不透明マスク, 空の行か, 選んだパレット, 0}
+inline int32_t rows[192][6]{};      // [y] = {u, v, du, dv, 空の行か, 有効か}（Mode7の行テーブル。表示に使った値）
+}
 class NesFxRacingPc : public BaseMapper {
     nesfx::FxRacingBoard _fx;
     nesfx::Mode7Ground _ground;
@@ -50,12 +55,15 @@ class NesFxRacingPc : public BaseMapper {
         if(_ground.hideFx[_ground.front])lo=hi=0;
         uint8_t alpha=0;
         if(y<192&&!_ground.hideFx[_ground.front])alpha=_displayAlpha[_fx.front*8192+nesfx::BitmapBoard::PixelByte(_tileX,unsigned(y),0)/2];
+        if(explainer::hideFx){lo=hi=alpha=0;}
         uint8_t mask=lo|hi|alpha;
         uint8_t bl=row.bg?bg.low:uint8_t(~bg.high);
         uint8_t bh=row.bg?bg.high:uint8_t(~bg.low);
         _block.low=(bl&~mask)|(~hi&mask);
         _block.high=(bh&~mask)|(~lo&mask);
         _block.palette=row.bg+(mask?2:0);
+        if(y<240&&_tileX/8<34){auto &e=explainer::info[y][_tileX/8];e[0]=mask;e[1]=row.bg;e[2]=_block.palette;}
+        if(y<192){auto &r=explainer::rows[y];r[0]=row.u;r[1]=row.v;r[2]=row.du;r[3]=row.dv;r[4]=row.bg;r[5]=row.valid;}
     }
 protected:
     uint16_t GetPRGPageSize() override {return 8192;}
diff --git D:/HomeBrew/FxRacingWeb/emulator/host.cpp rec/coresrc/emulator/host.cpp
