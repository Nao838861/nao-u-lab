digraph FamicomLineage {
graph [rankdir=TB, splines=ortho, nodesep=1.05, ranksep=2.1, pack=100, packmode="array_3", pad=0.7, bgcolor="white", outputorder=edgesfirst, concentrate=false, fontname="Meiryo", fontsize=26, labelloc=t, label="ファミコン初期100タイトルの系譜図\n上：影響元 → 下：影響先　／　国内FC発売順 1983.07.15〜1986.01.04\n緑実線：続編・先行版　　青実線：証言のある影響　　茶破線：推定\nFC 100本 ＋ 外部先行作品 36本　／　関係 138本\n破線は試作の仮説。配置の段は年代ではありません。"];
node [shape=plain, fontname="Meiryo"];
edge [arrowsize=0.85, penwidth=1.8, tailport=s, headport=n];
g000 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#475569" BGCOLOR="#fbe4e4"><TR><TD WIDTH="275" HEIGHT="60"><FONT FACE="Meiryo" POINT-SIZE="18" COLOR="#152238"><B>ドンキーコング</B></FONT></TD></TR><TR><TD BORDER="1" SIDES="T" COLOR="#94a3b8" BGCOLOR="white"><FONT FACE="Meiryo" POINT-SIZE="11" COLOR="#475569">#001  FC 1983.07.15 / 初出 1981</FONT></TD></TR></TABLE>>, tooltip="ドンキーコング / FC"];
