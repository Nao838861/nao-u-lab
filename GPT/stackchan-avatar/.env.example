# 最初は echo のままで、APIキーなしに画面と通信を確認できます。
STACKCHAN_AVATAR_BRAIN=echo

# OpenAIを使うときだけ設定します。
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# 必要な質問だけWeb検索します。lowが最も低コストです。
STACKCHAN_AVATAR_WEB_SEARCH_ENABLED=true
STACKCHAN_AVATAR_WEB_SEARCH_CONTEXT_SIZE=low

# 返答生成がこの秒数を超えた時だけ、短い相づちを先に話します。
STACKCHAN_AVATAR_FILLER_ENABLED=true
STACKCHAN_AVATAR_FILLER_DELAY_SECONDS=0.45

STACKCHAN_AVATAR_HOST=0.0.0.0
STACKCHAN_AVATAR_PORT=8000
STACKCHAN_AVATAR_MAX_HISTORY_TURNS=6
STACKCHAN_AVATAR_MAX_REPLY_CHARS=180
