{
  "name": "famicom-explainer-prototype",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "assets:prepare": "powershell -ExecutionPolicy Bypass -File tools/prepare-assets.ps1",
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ExplainerPrototype out/完成版/explainer_prototype_latest.mp4 --codec=h264 --crf=18",
    "narration:generate": "node tools/generate-narration.mjs",
    "narration:regenerate": "node tools/generate-narration.mjs --force",
    "narration:final-c01": "node tools/generate-narration.mjs --force --cut=C01",
    "narration:local": "powershell -ExecutionPolicy Bypass -File tools/generate-local-narration.ps1 -Force",
    "narration:report": "node tools/generate-narration.mjs --report-only",
    "narration:compact": "node tools/generate-narration.mjs --compact-only",
    "narration:generate-development": "node tools/generate-narration.mjs --manifest=development-cuts.json",
    "narration:regenerate-development": "node tools/generate-narration.mjs --manifest=development-cuts.json --force",
    "narration:compact-development": "node tools/generate-narration.mjs --manifest=development-cuts.json --compact-only",
    "narration:generate-drawing": "node tools/generate-narration.mjs --manifest=drawing-cuts.json",
    "narration:regenerate-drawing": "node tools/generate-narration.mjs --manifest=drawing-cuts.json --force",
    "narration:compact-drawing": "node tools/generate-narration.mjs --manifest=drawing-cuts.json --compact-only",
    "narration:test-intonation": "node tools/generate-narration.mjs --manifest=intonation-test-c08.json --force",
    "render:narration-preview": "remotion render src/index.ts ExplainerNarrationPreview out/完成版/explainer_narration_C01-C03.mp4 --codec=h264 --crf=18",
    "render:development-preview": "remotion render src/index.ts DevelopmentNarrationPreview out/完成版/explainer_narration_C04-C06.mp4 --codec=h264 --crf=18",
    "render:drawing-preview": "remotion render src/index.ts DrawingNarrationPreview out/完成版/explainer_narration_C08-C10.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts ExplainerPrototype out/explainer_prototype_preview.png --frame=885"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
